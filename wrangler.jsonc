{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marifitnnes-api",
  "preview_urls": false,
  "account_id": "c298c1122d9f24c1536110100b974559",
  "main": "worker/index.ts",
  "rules": [{"type":"Data","globs":["**/*.jpg"],"fallthrough":true}],
